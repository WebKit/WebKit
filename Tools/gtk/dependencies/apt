#!/usr/bin/env bash

source "$(dirname "$0")/../glib/dependencies/apt"

PACKAGES+=(
    # These are dependencies necessary for building WebKitGTK.
    geoclue-2.0
    libfaad-dev
    libffi-dev
    libgl1-mesa-dev
    libgtk-3-dev
    libgudev-1.0-dev
    libicu-dev
    libmount-dev
    libmpg123-dev
    libopus-dev
    libpango1.0-dev
    libpulse-dev
    librsvg2-dev
    libsecret-1-dev
    libsrtp2-dev
    libtheora-dev
    libvorbis-dev
    libvpx-dev
    unifdef
    $(aptIfExists libgtk-4-dev)

    # These are dependencies necessary for running tests.
    cups-daemon
    dbus-x11
    hunspell
    hunspell-en-gb
    hunspell-en-us
    weston
    xvfb

    # Icon themes needed by the MiniBrowser (generate-bundle needs this as well)
    adwaita-icon-theme
    gnome-icon-theme
    hicolor-icon-theme

    # These are dependencies necessary for building the jhbuild.
    libgbm-dev
    libgnutls28-dev
    libgpg-error-dev
    libpciaccess-dev
    libv4l-dev
    libunwind-dev
)

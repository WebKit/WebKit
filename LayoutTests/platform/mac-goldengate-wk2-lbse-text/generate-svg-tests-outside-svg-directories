#!/bin/sh
#
# Regenerates svg-tests-outside-svg-directories.txt, the --test-list used by the run-webkit-tests
# lines in this directory's TestExpectations.
#
# Usage (from anywhere in the checkout):
#    $ LayoutTests/platform/mac-goldengate-wk2-lbse-text/generate-svg-tests-outside-svg-directories
#
# 1. Find every file in LayoutTests that has SVG markup, creates SVG elements from script or
#    loads an SVG image. Tests whose SVG lives only in a separate script or resource file are missed.
# 2. Drop the directories that are passed to run-webkit-tests as a whole (SVG_DIRECTORIES below,
#    keep it in sync with the TestExpectations run lines).
# 3. Drop WPT helper files listed in imported/w3c/resources/resource-files.json. run-webkit-tests
#    honors the files listed there for --test-list entries, but not the directories, so it would
#    run the files in those directories as tests.
#
# The list may still contain support files and skipped tests. run-webkit-tests ignores files that
# are not tests, and the documented run lines pass --skipped=always so tests marked [ Skip ] are
# not run even though they are listed.

set -e

SVG_DIRECTORIES="
svg
css3/masking
imported/w3c/web-platform-tests/svg
imported/mozilla/svg
imported/blink/svg
imported/blink/css3
dom/svg
fast/svg
http/tests/svg
sar3/svg
imported/w3c/web-platform-tests/svg-aam
imported/w3c/web-platform-tests/content-security-policy/svg
imported/w3c/web-platform-tests/css/css-masking
imported/w3c/web-platform-tests/css/css-transforms
imported/w3c/web-platform-tests/css/filter-effects
"

THIS_DIR=$(cd "$(dirname "$0")" && pwd)
CHECKOUT=$(cd "$THIS_DIR/../../.." && pwd)
OUTPUT="$THIS_DIR/svg-tests-outside-svg-directories.txt"

EXCLUDED_DIRECTORIES=$(echo "$SVG_DIRECTORIES" | sed '/^$/d; s#^#^#; s#$#/#' | paste -sd'|' -)

cd "$CHECKOUT/LayoutTests"
TESTS=$(/usr/bin/grep -rlIi \
    --include='*.svg' --include='*.html' --include='*.htm' --include='*.xhtml' --include='*.xht' \
    --include='*.xml' --include='*.shtml' --include='*.php' --include='*.py' \
    -e '<svg' -e 'svg+xml' -e 'createElementNS([^)]*svg' -e '\.svg["'"'"' )#?]' . \
    | sed 's#^\./##' \
    | /usr/bin/grep -v -E '^platform/|-expected|-ref\.|/resources/|/support/|/reference/|/tools/' \
    | /usr/bin/grep -v -E "$EXCLUDED_DIRECTORIES" \
    | python3 -c '
import json
import sys

with open("imported/w3c/resources/resource-files.json") as file:
    resources = json.load(file)
directories = tuple("imported/w3c/" + directory + "/" for directory in resources["directories"])
files = set("imported/w3c/" + file for file in resources["files"])
for path in sys.stdin.read().split():
    if path not in files and not path.startswith(directories):
        print(path)
' \
    | sort -u)

if [ -z "$TESTS" ]; then
    echo "Found no tests" >&2
    exit 1
fi

{
    cat <<'EOF'
# SVG related tests that live outside the SVG directories passed to run-webkit-tests.
# Use with --test-list, see the run-webkit-tests lines in this directory's TestExpectations.
#
# Contains every test that has SVG markup, creates SVG elements from script or loads an SVG image.
# Tests whose SVG lives only in a separate script or resource file are not covered.
#
# Generated by generate-svg-tests-outside-svg-directories, do not edit by hand.
EOF
    echo "$TESTS"
} > "$OUTPUT"

echo "Wrote $(echo "$TESTS" | wc -l | tr -d ' ') tests to $OUTPUT"

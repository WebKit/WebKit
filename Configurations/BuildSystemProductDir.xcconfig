// Included by the tools, which are built above WebKit rather than as part of it.
// While the file included below is there, WebKit was built with CMake, and the
// tools build into the CMake directory it names, for the platform and
// configuration being built -- so each tool links the WebKit beside it, and the
// run-* scripts find the tool where they already look for that WebKit.
//
// build-webkit and set-webkit-configuration write that file whenever the build
// system they resolve is CMake, and delete it whenever it is Xcode. Without it
// WK_CMAKE_CONFIGURATION_BUILD_DIR is empty, and everything here resolves to the
// value the project was given, which is the Xcode product directory.

#include? "../WebKitBuild/BuildSystem.xcconfig"

WK_CONFIGURATION_BUILD_DIR = $(WK_CONFIGURATION_BUILD_DIR_CMAKE_$(WK_EMPTY_$(WK_CMAKE_CONFIGURATION_BUILD_DIR)));
WK_CONFIGURATION_BUILD_DIR_CMAKE_ = $(WK_CMAKE_CONFIGURATION_BUILD_DIR);
WK_CONFIGURATION_BUILD_DIR_CMAKE_YES = $(WK_CONFIGURATION_BUILD_DIR);

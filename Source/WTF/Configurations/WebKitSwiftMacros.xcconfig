PRODUCT_NAME = WebKitSwiftMacros;
EXECUTABLE_PREFIX = lib;
MACH_O_TYPE = mh_dylib;

// A Swift macro is a compiler plugin: swiftc dlopens it on the machine running
// the build. It is therefore always built for the host, even when the rest of
// the build is cross-compiling to iOS/watchOS/tvOS, and it is never installed.
// Consumers find it at $(SYMROOT)/$(CONFIGURATION), which is where a macosx
// target's products land regardless of the enclosing build's platform.
SDKROOT = macosx;
SUPPORTED_PLATFORMS = macosx;
SKIP_INSTALL = YES;
INSTALL_PATH = /usr/local/lib/webkit-swift-macros;

// The plugin only ever runs on the machine doing the build, and the toolchain's
// swift-syntax dylibs are single-arch, so building the usual universal slices
// would fail to link.
ARCHS = $(NATIVE_ARCH_ACTUAL);
ONLY_ACTIVE_ARCH = YES;

SWIFT_VERSION = 5.0;

// swift-syntax ships prebuilt inside the toolchain, so WebKit does not vendor
// it. Only SwiftSyntax and SwiftSyntaxMacros are usable here; the toolchain's
// SwiftCompilerPluginMessageHandling interface is package-scoped, which is why
// this is a dylib loaded with -load-plugin-library rather than an executable
// plugin loaded with -load-plugin-executable.
WK_SWIFT_SYNTAX_LIBRARY_DIR = $(TOOLCHAIN_DIR)/usr/lib/swift/host;
SWIFT_INCLUDE_PATHS = $(inherited) $(WK_SWIFT_SYNTAX_LIBRARY_DIR);
LIBRARY_SEARCH_PATHS = $(inherited) $(WK_SWIFT_SYNTAX_LIBRARY_DIR);
OTHER_LDFLAGS = -lSwiftSyntax -lSwiftSyntaxMacros -Wl,-rpath,$(WK_SWIFT_SYNTAX_LIBRARY_DIR);

// Deliberately not inherited: the shared Swift flags configure C++ interop and
// load this very plugin, which would be circular.
OTHER_SWIFT_FLAGS = ;
SWIFT_OBJC_INTEROP_MODE = ;
GCC_PREFIX_HEADER = ;

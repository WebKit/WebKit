#!/bin/bash
#
# clang-wrapper [--wk-merge-flags=<flags>] <compile-command...>
#
# When WK_UNIFIED_SOURCES_BUNDLE_POLICY is "Bundle", or when compiling
# a non-unified-source file, this script is a simple pass-through.
#
# Otherwise, this script makes N copies of <compile-command...>, one for each
# unified source bundle member, and uses ninja + the compiler driver to compile
# each one and then merge the results (ld -r) into a unified .o and .d file.
#
# The end result is as-if we built the unified bundle, but with the performance
# of building indivdiual member files with individual dependency tracking.
#
# This works because ninja's only contract is: input => tool => (output, deps).
# From the outer ninja's perspective, it doesn't matter how 'tool' computes
# (output, deps).
#
# Bundling is purely an optimization decision. Either policy is always valid.
#
# Options that start with --wk- are consumed by this wrapper; CMake uses them
# to pass toolchain-specific flags for the merge step (WebKitCCache.cmake).
#
# The pass-through path is bash to minimize startup cost. The NoBundle path
# re-execs this same file under perl -x, which skips ahead to the perl
# shebang below.

if [[ "$WK_UNIFIED_SOURCES_BUNDLE_POLICY" != NoBundle ]]; then
    while [[ "$1" == --wk-* ]]; do
        shift
    done
    exec "$@"
fi

exec perl -x "$0" "$@"

#!/usr/bin/perl
use strict;
use warnings;

# Wrapper options come first.
my $mergeFlags = '';
while (@ARGV && $ARGV[0] =~ /^--wk-/) {
    my $option = shift(@ARGV);
    if ($option =~ /^--wk-merge-flags=(.*)$/) {
        $mergeFlags = $1;
    } else {
        die("clang-wrapper: unknown option $option\n");
    }
}

# Extract the flags that describe our input and output, and preserve the rest
# for reuse in our ninja commands.
my $sourceFile;
my $outputFile;
my $depFile;
my @driverArgs;
for (my $i = 0; $i < scalar(@ARGV); ++$i) {
    my $arg = $ARGV[$i];
    if ($arg eq '-c') {
        $sourceFile = $ARGV[++$i];
        next;
    }
    if ($arg eq '-o') {
        $outputFile = $ARGV[++$i];
        next;
    }
    if ($arg eq '-MF') {
        $depFile = $ARGV[++$i];
        next;
    }
    if ($arg eq '-MT' || $arg eq '-x') {
        ++$i;
        next;
    }
    push(@driverArgs, $arg);
}

# Pass through non-unified sources.
if (!defined($sourceFile) || $sourceFile !~ m{/unified-sources/[A-Za-z]*UnifiedSource}) {
    exec(@ARGV);
}

my ($extension) = $sourceFile =~ /\.(\w+)$/;
my $membersFolder = "$outputFile.members";

# The first NoBundle compile of a bundle builds every member separately: 2-4x the CPU of the
# bundle (each member re-parses what the bundle parsed once) for about the same wall time on
# an idle machine, and every later edit is then cheap. Only pay that when few bundles are dirty;
# otherwise compile the bundle as a whole (it can still be split by a later, smaller build).
if (!-e "$membersFolder/.ninja_log" && ($ENV{WK_UNIFIED_SOURCES_DIRTY_BUNDLES} // 1) > 2) {
    exec(@ARGV);
}
mkdir($membersFolder);

# Expand the bundle into one stub source file per member.
my @memberObjects;
my $ccEdges = '';
my $memberCount = 0;
open(my $bundle, '<', $sourceFile) or die("$sourceFile: $!\n");
while (my $line = <$bundle>) {
    chomp($line);
    if ($line !~ /^#include /) {
        next;
    }
    my $stub = "$membersFolder/m$memberCount.$extension";
    my $object = "$membersFolder/m$memberCount.o";
    writeFileIfChanged($stub, "$line\n");
    $ccEdges .= "build $object | $object.d: cc $stub\n";
    push(@memberObjects, $object);
    ++$memberCount;
}
close($bundle);

my $ccPrefix = join(' ', map { shellQuote($_) } @driverArgs);
my $quotedDepFile = shellQuote($depFile);
my $memberObjectList = join(' ', @memberObjects);
my $memberDepList = join(' ', map { "$_.d" } @memberObjects);

# Rule bodies are literal: $cc_prefix, $in, $out, etc. are all ninja variables.
# "ld -r" keeps every symbol of its inputs on ELF; Mach-O additionally needs
# -keep_private_externs, which CMake passes through --wk-merge-flags.
my $rules = <<'END_OF_RULES';
rule cc
  command = $cc_prefix -MD -MT $out -MF $out.d -o $out -c $in
  depfile = $out.d
  description = member $in

rule merge
  command = $cc_prefix $merge_flags -r -nostdlib -o $out $in && cat $member_deps > $bundle_dep
  description = merge $out
END_OF_RULES

my $buildNinja = <<"END_OF_NINJA";
ninja_required_version = 1.3
builddir = $membersFolder
cc_prefix = $ccPrefix
merge_flags = $mergeFlags
bundle_dep = $quotedDepFile
member_deps = $memberDepList
$rules
$ccEdges
build $outputFile | $depFile: merge $memberObjectList
default $outputFile
END_OF_NINJA

writeFileIfChanged("$membersFolder/build.ninja", $buildNinja);

my $ninja = $ENV{WK_NINJA};
if (!$ninja) {
    chomp($ninja = `which ninja 2>/dev/null` || `xcrun -f ninja 2>/dev/null`);
}
my @jobs = $ENV{WK_UNIFIED_SOURCES_MEMBER_JOBS} ? ('-j', $ENV{WK_UNIFIED_SOURCES_MEMBER_JOBS}) : ();
exec($ninja, '--quiet', @jobs, '-f', "$membersFolder/build.ninja");
die("exec ninja: $!\n");

sub shellQuote {
    my ($s) = @_;
    if ($s =~ /^[A-Za-z0-9_\-+=:,.\/]+$/) {
        return $s;
    }
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

sub writeFileIfChanged {
    my ($path, $newContent) = @_;
    if (-f $path) {
        local $/;
        open(my $in, '<', $path);
        my $oldContent = <$in>;
        close($in);
        if (defined($oldContent) && $oldContent eq $newContent) {
            return;
        }
    }
    open(my $out, '>', $path) or die("$path: $!\n");
    print($out $newContent);
    close($out);
}

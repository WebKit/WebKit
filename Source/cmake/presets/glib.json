{
    "version": 4,
    "include": ["common.json"],
    "configurePresets": [
        {
            "name": "glib",
            "hidden": true,
            "inherits": ["ninja"],
            "cacheVariables": {
                "CMAKE_C_COMPILER": {
                    "type": "STRING",
                    "value": "clang"
                },
                "CMAKE_CXX_COMPILER": {
                    "type": "STRING",
                    "value": "clang++"
                }
            }
        }
    ]
}

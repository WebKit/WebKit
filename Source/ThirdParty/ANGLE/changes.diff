+        constexpr GLsizeiptr kReadSize = kWidth * kHeight * sizeof(GLColor);
+        void *mappedPtr = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, kReadSize, GL_MAP_READ_BIT);

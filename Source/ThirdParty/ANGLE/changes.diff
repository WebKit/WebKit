diff --git a/src/tests/gl_tests/IntegerOverflowClampTest.cpp b/src/tests/gl_tests/IntegerOverflowClampTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..70d8f1b9dabc7ceddc43ec5d0133ecbc6e811c6f
--- /dev/null
+++ b/src/tests/gl_tests/IntegerOverflowClampTest.cpp
@@ -0,0 +1,175 @@
+//

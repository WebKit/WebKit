+    const angle::Format &lumaAngleFormat = angle::Format::Get(angle::FormatID::R8_UNORM);
+    return displayMtl->getUtils().copyTextureWithDraw(context, cmdEncoder, lumaAngleFormat,
+                                                      dstAngleFormat, blitParams);
 }
 

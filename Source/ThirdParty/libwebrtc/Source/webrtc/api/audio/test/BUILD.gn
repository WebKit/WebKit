if (is_android) {
  import("//build/config/android/config.gni")
  import("//build/config/android/rules.gni")
}

if (rtc_include_tests) {
  rtc_cc_test("audio_frame_unittest") {
    sources = [ "audio_frame_unittest.cc" ]
    deps = [
      "..:audio_frame_api",
      "../../../rtc_base:checks",
      "../../../test:test_support",
    ]
  }

  rtc_cc_test("audio_view_unittest") {
    sources = [ "audio_view_unittest.cc" ]
    deps = [
      "..:audio_frame_api",
      "../../../test:test_support",
    ]
  }

  rtc_cc_test("echo_canceller3_config_unittest") {
    sources = [ "echo_canceller3_config_unittest.cc" ]
    deps = [
      "..:aec3_config",
      "../../../modules/audio_processing:aec3_config_json",
      "../../../test:test_support",
    ]
  }
}

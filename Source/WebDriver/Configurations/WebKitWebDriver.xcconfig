#include "DebugRelease.xcconfig"

LD_RUNPATH_SEARCH_PATHS = "@loader_path";

// Find frameworks built by WebKit (JavaScriptCore.framework, etc.) in the build products dir.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR);
LIBRARY_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR);

PRODUCT_NAME = WebKitWebDriver;
GCC_ENABLE_OBJC_EXCEPTIONS = YES;

// Link against JavaScriptCore (for WTF, JSON, RemoteInspector), Foundation (for Obj-C runtime),
// AppKit (for NSWorkspace app launching), and Security (CommonCrypto for WebSocket SHA-1).
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -framework JavaScriptCore -framework Foundation -framework AppKit -framework Security -lWTF -lbmalloc;

// Enable WebDriver BiDi support.
// Disable security assertions and ref-counted lifecycle checks to avoid linker issues
// with RefCountDebugger symbols. The WTF inline headers generate references through the
// 'using RefCountDebugger' alias, producing mangled names that differ from the actual
// RefCountDebuggerBase definitions in libWTF.a. Since WebKitWebDriver is a standalone
// tool, these debug assertions are not needed.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) ENABLE_WEBDRIVER_BIDI=1 ENABLE_SECURITY_ASSERTIONS=0 CHECK_REF_COUNTED_LIFECYCLE=0;

OTHER_CFLAGS = $(inherited) -Wno-macro-redefined;

// The WebDriver daemon's DerivedSources (WebDriverAtoms) are generated by a script build phase.
DERIVED_FILE_DIR = $(BUILT_PRODUCTS_DIR)/DerivedSources/WebDriver;

STRIP_STYLE = debugging;

    };
    return std::span<const CSSPropertyID> { propertiesExcludingThreadedOnly };
}

CSSPropertySettings::CSSPropertySettings(const Settings& settings)
    : cssDescriptorEnabled { settings.cssDescriptorEnabled() }
    , cssSettingsCoordinatedValueListEnabled { settings.cssSettingsCoordinatedValueListEnabled() }
    , cssSettingsOneEnabled { settings.cssSettingsOneEnabled() }
    , cssSettingsRenderStyleStorageEnabled { settings.cssSettingsRenderStyleStorageEnabled() }
    , cssSettingsShorthandEnabled { settings.cssSettingsShorthandEnabled() }
{
}

bool operator==(const CSSPropertySettings& a, const CSSPropertySettings& b)
{
    return a.cssDescriptorEnabled == b.cssDescriptorEnabled
        && a.cssSettingsCoordinatedValueListEnabled == b.cssSettingsCoordinatedValueListEnabled
        && a.cssSettingsOneEnabled == b.cssSettingsOneEnabled
        && a.cssSettingsRenderStyleStorageEnabled == b.cssSettingsRenderStyleStorageEnabled
        && a.cssSettingsShorthandEnabled == b.cssSettingsShorthandEnabled;
}

void add(Hasher& hasher, const CSSPropertySettings& settings)
{
    add(hasher, WTF::packBools(
        settings.cssDescriptorEnabled,
        settings.cssSettingsCoordinatedValueListEnabled,
        settings.cssSettingsOneEnabled,
        settings.cssSettingsRenderStyleStorageEnabled,
        settings.cssSettingsShorthandEnabled
    ));
}


TextStream& operator<<(TextStream& stream, CSSPropertyID property)
{
    return stream << nameLiteral(property);
}

static constexpr std::array validKeywordsForTestUsingSharedRule {
    CSSValueID::Auto,
};

static constexpr std::array validKeywordsForTestUsingSharedRuleExported {
    CSSValueID::Auto,
};

static constexpr std::array validKeywordsForTestUsingSharedRuleWithOverrideFunction {
    CSSValueID::Auto,
};

std::span<const CSSValueID> CSSProperty::validKeywordsForProperty(CSSPropertyID id)
{
    switch (id) {
    case CSSPropertyID::TestUsingSharedRule:
        return std::span<const CSSValueID> { validKeywordsForTestUsingSharedRule };
    case CSSPropertyID::TestUsingSharedRuleExported:
        return std::span<const CSSValueID> { validKeywordsForTestUsingSharedRuleExported };
    case CSSPropertyID::TestUsingSharedRuleWithOverrideFunction:
        return std::span<const CSSValueID> { validKeywordsForTestUsingSharedRuleWithOverrideFunction };
    default:
        return { };
    }
}

bool CSSProperty::isKeywordValidForPropertyValues(CSSPropertyID id, CSSValueID keyword, const CSSParserContext& context)
{
    switch (id) {
    case CSSPropertyID::TestUsingSharedRule:
        return std::ranges::find(validKeywordsForTestUsingSharedRule, keyword) != validKeywordsForTestUsingSharedRule.end();
    case CSSPropertyID::TestUsingSharedRuleExported:
        return std::ranges::find(validKeywordsForTestUsingSharedRuleExported, keyword) != validKeywordsForTestUsingSharedRuleExported.end();
    case CSSPropertyID::TestUsingSharedRuleWithOverrideFunction:
        return std::ranges::find(validKeywordsForTestUsingSharedRuleWithOverrideFunction, keyword) != validKeywordsForTestUsingSharedRuleWithOverrideFunction.end();
    default:
        return false;
    }
}


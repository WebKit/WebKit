bool CSSProperty::isInheritedProperty(CSSPropertyID id)
{
    ASSERT(std::to_underlying(id) < cssPropertyIDEnumValueCount);
    ASSERT(id != CSSPropertyID::Invalid);
    return isInheritedPropertyTable[std::to_underlying(id)];
}


#include "config.h"
#include "QuirksAccessors.h"

#include "Document.h"
#include "ElementAncestorIteratorInlines.h"
#include "ElementInlines.h"
#include "QuirkTable.h"
#include "SelectorQuery.h"
#include "Settings.h"

namespace WebCore {

QuirksAccessors::QuirksAccessors(Document& document)
    : m_document(document)
{
}

QuirksAccessors::~QuirksAccessors() = default;

bool QuirksAccessors::needsQuirks() const
{
    return m_document && m_document->settings().needsSiteSpecificQuirks();
}

bool QuirksAccessors::elementMatchesSelectorCondition(const String& selector, const Node* node)
{
    if (!node)
        return false;

    RefPtr element = lineageOfType<Element>(*node).first();
    if (!element)
        return false;

    auto* query = SelectorQueryCache::singleton().add(selector, protect(element->document()));
    if (!query) {
        ASSERT_NOT_REACHED();
        return false;
    }

    // FIXME: Remove this suppression once rdar://189998365 is fixed.
    SUPPRESS_MEMORY_UNSAFE_CAST return query->matches(const_cast<Element&>(*element));
}

bool QuirksAccessors::behaviorAppliesToNode(QuirkBehaviorID id, const Node* node) const
{
    if (!m_quirksData.isBehaviorEnabled(id))
        return false;

    for (const auto& behavior : m_quirksData.behaviors()) {
        if (behavior.id != id)
            continue;

        if (behavior.elementSelector.isNull())
            return true;

        if (elementMatchesSelectorCondition(behavior.elementSelector, node))
            return true;
    }

    return false;
}

RefPtr<Element> QuirksAccessors::firstElementMatchingSelectorCondition(const String& selector, Document& document)
{
    auto* query = SelectorQueryCache::singleton().add(selector, document);
    if (!query) {
        ASSERT_NOT_REACHED();
        return nullptr;
    }

    return query->queryFirst(document);
}

RefPtr<Element> QuirksAccessors::elementMatchingDocumentSelectorCondition(QuirkBehaviorID id) const
{
    if (!m_quirksData.isBehaviorEnabled(id))
        return nullptr;

    RefPtr document = m_document.get();
    if (!document)
        return nullptr;

    for (const auto& behavior : m_quirksData.behaviors()) {
        if (behavior.id != id || behavior.documentSelector.isNull())
            continue;

        if (RefPtr element = firstElementMatchingSelectorCondition(behavior.documentSelector, *document))
            return element;
    }

    return nullptr;
}

bool QuirksAccessors::behaviorAppliesToDocument(QuirkBehaviorID id) const
{
    if (!m_quirksData.isBehaviorEnabled(id))
        return false;

    bool appliesUnconditionally = std::ranges::any_of(m_quirksData.behaviors(), [&](const auto& behavior) {
        return behavior.id == id && behavior.documentSelector.isNull();
    });

    return appliesUnconditionally || elementMatchingDocumentSelectorCondition(id);
}

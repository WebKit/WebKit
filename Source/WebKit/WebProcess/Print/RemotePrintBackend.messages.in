#if ENABLE(GPU_PROCESS) && PLATFORM(COCOA)

[
    DispatchedFrom=WebContent,
    DispatchedTo=Printing
]
messages -> RemotePrintBackend Stream {
    CreateSnapshot(WebKit::RemoteSnapshotIdentifier snapshotIdentifier, WebCore::FrameIdentifier rootFrameIdentifier, WebCore::FloatSize size) -> () Synchronous
    CreateSnapshotRecorder(WebKit::RemoteSnapshotRecorderIdentifier identifier, WebKit::RemoteSnapshotIdentifier snapshotIdentifier)
    SinkSnapshotRecorderIntoSnapshotFrame(WebKit::RemoteSnapshotRecorderIdentifier identifier, WebCore::FrameIdentifier frameIdentifer) -> (bool success)

    CreateDisplayListRecorder(WebKit::RemoteDisplayListRecorderIdentifier identifier)
    SinkDisplayListRecorderIntoDisplayList(WebKit::RemoteDisplayListRecorderIdentifier identifier, WebKit::RemoteDisplayListIdentifier displayListIdentifier)
    ReleaseDisplayList(WebKit::RemoteDisplayListIdentifier identifier) StreamBatched

    CacheNativeImage(WebCore::ShareableBitmapHandle handle, WebCore::RenderingResourceIdentifier renderingResourceIdentifier) NotStreamEncodable
    ReleaseNativeImage(WebCore::RenderingResourceIdentifier identifier)
    CachePathImpl(Ref<WebCore::PathImpl> path, WebKit::RemotePathImplIdentifier identifier)
    ReleasePathImpl(WebKit::RemotePathImplIdentifier identifier)
    CacheFont(struct WebCore::FontInternalAttributes data, struct WebCore::FontPlatformDataAttributes platformData, std::optional<WebCore::RenderingResourceIdentifier> renderingResourceIdentifier) NotStreamEncodable
    ReleaseFont(WebCore::RenderingResourceIdentifier identifier)
    CacheFontCustomPlatformData(struct WebCore::FontCustomPlatformSerializedData fontCustomPlatformData) NotStreamEncodable
    ReleaseFontCustomPlatformData(WebCore::RenderingResourceIdentifier identifier)
    CacheGradient(Ref<WebCore::Gradient> gradient, WebKit::RemoteGradientIdentifier identifier)
    ReleaseGradient(WebKit::RemoteGradientIdentifier identifier)
    CacheFilter(Ref<WebCore::Filter> filter) NotStreamEncodable
    ReleaseFilter(WebCore::RenderingResourceIdentifier identifier)
    CachePDFDocument(WebCore::RenderingResourceIdentifier identifier, WebCore::SharedMemory::Handle data) NotStreamEncodable
    ReleasePDFDocument(WebCore::RenderingResourceIdentifier identifier)
    DrawPDFPage(WebKit::RemoteSnapshotRecorderIdentifier recorderIdentifier, WebCore::RenderingResourceIdentifier documentIdentifier, uint32_t pageIndex, WebCore::FloatRect source, WebCore::FloatRect destination, bool includeLinks)
    ReleaseMemory()
}

#endif // ENABLE(GPU_PROCESS) && PLATFORM(COCOA)

dictionary WebExtensionTestCPPOptions {
    required DOMString name;
    double count;
    boolean enabled = false;
    sequence<DOMString> tags;
    (DOMString or sequence<DOMString>) urls;
    double? index;
    record<DOMString, DOMString> headers;
};

// Covers the C++ path of the generator, which UseCPPAPI selects: the same arguments as JSON values and JavaScript values, and String exceptions.
[
    Conditional=WK_WEB_EXTENSIONS,
    ReturnsPromiseWhenCallbackIsOmitted,
    NeedsPageIdentifierWithCallbackHandler,
    UseCPPAPI,
] interface WebExtensionAPITestCPP {

    [NeedsScriptContext] void notifyFail([Optional] DOMString message);
    [NeedsScriptContext] void sendMessage(DOMString message, [Optional, ValuesAllowed] any argument);
    [NeedsScriptContext, NeedsFrame] any runWithUserGesture([ValuesAllowed] any function);
    boolean isProcessingUserGesture();
    [RaisesException, NeedsScriptContext] void assertEq([ValuesAllowed] any actualValue, [ValuesAllowed] any expectedValue, [Optional] DOMString message);
    [NeedsScriptContext, ProcessArgumentsLeftToRight] any assertRejects(any promise, [Optional, ValuesAllowed] any expectedError, [Optional] DOMString message);

    [RaisesStringException, ImplementedAs=createAlarm] void create([Optional] DOMString name, [JSONValue] any info, [Optional, CallbackHandler] function callback);
    void get([Optional] DOMString name, [Optional, CallbackHandler] function callback);
    void getAll([Optional, CallbackHandler] function callback);
    void clear([Optional] DOMString name, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void getItems([Optional, JSONObject=StopAtTopLevel, DOMString] any items, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void getBytesInUse([Optional, JSONObject, DOMString] any keys, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsScriptContext] void set(any items, [Optional, CallbackHandler] function callback);
    [RaisesStringException, Dynamic] void setAccessLevel([JSONValue] any accessOptions, [Optional, CallbackHandler] function callback);

    [URL, ConvertNullStringTo=Null, RaisesStringException] DOMString getURL(DOMString resourcePath);
    [JSONValue] any getManifest();
    [RaisesStringException, NeedsFrame, ProcessArgumentsLeftToRight] void sendRuntimeMessage([Optional] DOMString extensionID, [Serialization=Message] any message, [Optional, JSONValue] any options, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void configure(WebExtensionTestCPPOptions options, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void select([CustomType=WebExtensionTabIdentifier] optional double tabId, [CallbackHandler] optional function callback);

    readonly attribute WebExtensionAPIEvent onAlarm;
    [ImplementedAs=quotaBytes] readonly attribute double QUOTA_BYTES;
    [ImplementedAs=maxItems, Dynamic] readonly attribute unsigned long MAX_ITEMS;

};

// What each member type becomes in C++ and how it is parsed from JavaScript.
[
    ImplementedAs=WebExtensionTestItemKind
] enum WebExtensionTestKind {
    "bookmark",
    "folder"
};

[
    ImplementedAs=WebExtensionTestItemProperties
] dictionary WebExtensionTestItem {
    // Unions and nullable members.
    (DOMString or sequence<DOMString>) urls;
    double? index;
    required (double or DOMString) position;

    // Null is a value here, and not the same as leaving the member out.
    [CustomType=WebExtensionJSONValue, PreserveNull] any payload;

    // Records.
    record<DOMString, DOMString> headers;
    record<DOMString, sequence<DOMString>> formData;
    record<DOMString, any> extras;

    // Custom types that parse to a C++ type.
    [CustomType=WebExtensionTabIdentifier] double tabId;
    [CustomType=WebExtensionWindowIdentifier] double? windowId;
    [CustomType=WebExtensionFrameIdentifier] double frameId;
    [CustomType=UUID] DOMString documentId;
    [CustomType=WebExtensionCookieStoreIdentifier] DOMString storeId;
    [CustomType=WebExtensionMatchPattern] DOMString pattern;
    [CustomType=WebExtensionJSONObject] any rule;
    [CannotBeEmpty] URL address;

    // A name in C++ that differs from the one in JavaScript.
    [ImplementedAs=identifier] DOMString id;
    WebExtensionTestKind kind = "folder";
};

[
    Conditional=WK_WEB_EXTENSIONS,
    MainWorldOnly,
    ReturnsPromiseWhenCallbackIsOmitted
] interface WebExtensionAPITestTypes {
    // The optional keyword.
    void add(WebExtensionTestItem item, optional DOMString parentId, [CallbackHandler] optional function callback);
    void find(optional WebExtensionTestItem query, [CallbackHandler] optional function callback);
    void tag((DOMString or sequence<DOMString>) names, [CallbackHandler] optional function callback);
    void select([CustomType=WebExtensionTabIdentifier] optional double tabId, optional (double or DOMString) target, [CallbackHandler] optional function callback);
    void forget([CustomType=WebExtensionMatchPattern] sequence<DOMString> patterns, [CallbackHandler] optional function callback);
    void sync(record<DOMString, sequence<DOMString>> headers, [CallbackHandler] optional function callback);
    void use([CustomType=WebExtensionCookieStoreIdentifier] DOMString storeId, [CustomType=WebExtensionFrameIdentifier] optional double frameId, [CustomType=UUID] optional DOMString documentId);
    void open([CustomType=URL, CannotBeEmpty] DOMString address, [CallbackHandler] optional function callback);
};

dictionary WebExtensionTestObjCOptions {
    required DOMString name;
    double count;
    boolean enabled = false;
    sequence<DOMString> tags;
};

// Covers the Objective-C path of the generator: arguments converted to Foundation objects, exceptions, and what a call needs from its context.
[
    Conditional=WK_WEB_EXTENSIONS,
    MainWorldOnly,
    ReturnsPromiseWhenCallbackIsOmitted,
] interface WebExtensionAPITestObjC {

    // Arguments that are converted to Foundation objects.
    [RaisesException] void setDictionary([NSDictionary] any options, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void getNullableDictionary([Optional, NSDictionary=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesException] void enable([Optional, NSObject=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesException] void registerScripts([NSArray=NSDictionary] array scripts, [Optional, CallbackHandler] function callback);
    [RaisesStringException, ImplementedAs=createItem] void create([Optional] DOMString name, [JSONValue] any info, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void get([Optional, JSONObject=StopAtTopLevel, DOMString] any items, [Optional, CallbackHandler] function callback);
    [JSONValue] any getManifest();
    [RaisesException, NeedsFrame] void postMessage([Serialization=Message] any message);
    DOMString getMessage([CannotBeEmpty] DOMString name, [Optional, ValuesAllowed] any substitutions);
    [URL, ConvertNullStringTo=Null, RaisesException, Dynamic] DOMString getURL(DOMString resourcePath);
    [NeedsScriptContext] any runTests([Vector=JSValueRef] array tests);

    [RaisesException] void configure(WebExtensionTestObjCOptions options, [Optional, CallbackHandler] function callback);

    // What a call needs from its context.
    [RaisesException, NeedsPageIdentifier] void openPopup([Optional, NSDictionary=NullAllowed] any options, [Optional, CallbackHandler] function callback);
    [RaisesException, ImplementedAs=createMenu, NeedsPage, NeedsFrame] void createMenu([NSDictionary=NullAllowed] any properties, [Optional, CallbackHandler] function callback);
    [ProcessArgumentsLeftToRight, RaisesException, Conditional=WK_WEB_EXTENSIONS_NOTIFICATIONS] void notify([Optional] DOMString notificationId, [NSDictionary] any options, [Optional, CallbackHandler] function callback);
    [MainWorldOnly, NeedsScriptContext] any getBackgroundPage();
    [NeedsFrameIdentifier] void addListener([CallbackHandler] function listener);
    [NeedsFrameIdentifier] void removeListener([CallbackHandler] function listener);
    boolean hasListener([CallbackHandler] function listener);

    // Attributes.
    readonly attribute WebExtensionAPIEvent onChanged;
    [NeedsPage] readonly attribute double tabId;
    [ImplementedAs=rootNodeIdentifier] readonly attribute DOMString ROOT_NODE_ID;
    [MainWorldOnly, Dynamic, Platform=COCOA] readonly attribute WebExtensionAPIAction action;

};

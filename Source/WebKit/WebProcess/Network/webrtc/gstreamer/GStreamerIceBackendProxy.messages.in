#if USE(GSTREAMER_WEBRTC)

[
    ExceptionForEnabledBy,
    DispatchedFrom=Networking,
    DispatchedTo=WebContent
]
messages -> GStreamerIceBackendProxy {
    NotifyNewCandidate(unsigned sessionId, String candidate);
    NotifyGatheringDone(unsigned streamId);
    NotifyComponentStateChanged(unsigned streamId, enum:uint8_t WebCore::RTCIceComponent component, enum:uint8_t WebCore::RTCIceConnectionState state);
    NotifyNewSelectedPair(unsigned streamId, enum:uint8_t WebCore::RTCIceComponent component);
    NotifyDataRead(unsigned streamId, enum:uint8_t WebCore::RTCIceComponent component, std::span<const uint8_t> data);
}

#endif
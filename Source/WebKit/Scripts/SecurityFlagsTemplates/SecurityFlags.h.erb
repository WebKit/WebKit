#pragma once

#include <optional>
#include <wtf/BitSet.h>
#include <wtf/PageBlock.h>
#include <wtf/RuntimeApplicationChecks.h>
#include <wtf/StdLibExtras.h>
#include <wtf/text/StringView.h>

namespace WebKit::SecurityFlags {

// Generated from Source/WTF/Scripts/Preferences/SecurityFlags.yaml. Stores the *disabled* flags, so zero means every fix is enforced.
// Reads are atomic per flag, so a check may run on any thread.
struct Storage {
    static constexpr size_t flagCount = <%= @securityFlags.size %>;

    Storage() = default;
    Storage(const Storage&) = default;

    // Overwriting the words in place is not safe against a reader on another thread, so replaceWith() is the only way.
    Storage& operator=(const Storage&) = delete;

    static const Storage& forProcess();

<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
    // <%= flag.humanReadableDescription %>
    bool <%= flag.name %>() const { return !m_disabledFlags.concurrentGet(<%= flag.index %>); }
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>

    // False when this build has no flag by that name, which is expected rather than an error.
    bool disableFlagNamed(StringView);

    // Applies one flag at a time, so a reader on another thread always sees a well-defined value for the flag it asked about.
    void replaceWith(const Storage&);

    // Replaces the value forProcess() answers; true when that value changed.
    static bool update(Storage&&);

    bool operator==(const Storage&) const = default;

    // Nullopt if this build has no flag by that name.
    std::optional<bool> isFlagEnabledNamedForTesting(StringView) const;

private:
    WTF::BitSet<flagCount> m_disabledFlags;
};

struct Page {
    // A flag's bit is its sorted position, so two builds with different lists would read each other's bits as
    // other fixes. Nothing else catches that, because what is shared is the bits and not the names.
    static constexpr uint64_t expectedMagic = 0x5ECF1A6553484450ULL;
    static constexpr uint64_t expectedLayoutHash = <%= @layoutHash %>ULL;

    bool isValid() const { return magic == expectedMagic && layoutHash == expectedLayoutHash; }

    uint64_t magic;
    uint64_t layoutHash;
    Storage flags;
};

// Raw storage, not a Page object: a constructor would run after the mapping is in place and fault. Not exported,
// or a flag read would go through a writable GOT slot.
constexpr size_t pageStorageSize = WTF::CeilingOnPageSize;
extern "C" uint64_t g_securityFlagsPageStorage[pageStorageSize / sizeof(uint64_t)];

inline Page& page() { return *std::bit_cast<Page*>(&g_securityFlagsPageStorage[0]); }

static_assert(sizeof(Page) <= pageStorageSize);

inline const Storage& Storage::forProcess() { return page().flags; }

// Cocoa-only: anywhere else a flag reads as disabled, because no other port builds a branch that has these flags.
#if PLATFORM(COCOA)
<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
inline bool <%= flag.name %>() { return Storage::forProcess().<%= flag.name %>(); }
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>
#else
<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
inline bool <%= flag.name %>() { return false; }
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>
#endif

} // namespace WebKit::SecurityFlags

namespace WebKit {

inline const SecurityFlags::Storage& securityFlags() { return SecurityFlags::Storage::forProcess(); }

} // namespace WebKit

#include "config.h"
#include "SecurityFlags.h"

namespace WebKit {

bool SecurityFlags::disableFlagNamed(StringView name)
{
<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
    if (name == "<%= flag.name %>"_s) {
        m_disabledFlags.concurrentTestAndSet(<%= flag.index %>);
        return true;
    }
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>
    return false;
}

std::optional<bool> SecurityFlags::isFlagEnabledNamedForTesting(StringView name) const
{
<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
    if (name == "<%= flag.name %>"_s)
        return <%= flag.name %>();
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>
    return std::nullopt;
}

void SecurityFlags::replaceWith(const SecurityFlags& other)
{
    for (size_t index = 0; index < flagCount; ++index) {
        if (other.m_disabledFlags.get(index))
            m_disabledFlags.concurrentTestAndSet(index);
        else
            m_disabledFlags.concurrentTestAndClear(index);
    }
}

} // namespace WebKit

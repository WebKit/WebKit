#include "config.h"
#include "SecurityFlags.h"

#include <wtf/RunLoop.h>
#include <wtf/RuntimeApplicationChecks.h>

namespace WebKit::SecurityFlags {

// Its own section so nothing else lands on the page, and no extern "C" here: that would make this a declaration.
alignas(WTF::CeilingOnPageSize) __attribute__((used, section("__DATA,__wk_secflags")))
uint64_t g_securityFlagsPageStorage[pageStorageSize / sizeof(uint64_t)];

bool Storage::update(Storage&& flags)
{
    RELEASE_ASSERT(!isInAuxiliaryProcess());
    ASSERT(RunLoop::isMain());

    auto& current = page().flags;
    if (flags == current)
        return false;

    current.replaceWith(flags);
    return true;
}

bool Storage::disableFlagNamed(StringView name)
{
<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
    if (name == "<%= flag.name %>"_s) {
        m_disabledFlags.concurrentTestAndSet(<%= flag.index %>);
        return true;
    }
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>
    return false;
}

std::optional<bool> Storage::isFlagEnabledNamedForTesting(StringView name) const
{
<% @securityFlags.each do |flag| -%>
<%- if flag.condition -%>
#if <%= flag.condition %>
<%- end -%>
    if (name == "<%= flag.name %>"_s)
        return <%= flag.name %>();
<%- if flag.condition -%>
#endif
<%- end -%>
<% end -%>
    return std::nullopt;
}

void Storage::replaceWith(const Storage& other)
{
    for (size_t index = 0; index < flagCount; ++index) {
        if (other.m_disabledFlags.get(index))
            m_disabledFlags.concurrentTestAndSet(index);
        else
            m_disabledFlags.concurrentTestAndClear(index);
    }
}

} // namespace WebKit::SecurityFlags

#if ENABLE(GPU_PROCESS)

[
    DispatchedFrom=WebContent,
    DispatchedTo=GPU,
    EnabledBy=WebGPUEnabled
]
messages -> RemoteDevice Stream {
    void Destroy()
    void Destruct()
    void CreateXRBinding(WebKit::WebGPUXRBindingIdentifier identifier)
    void CreateBuffer(WebKit::WebGPU::BufferDescriptor descriptor, WebKit::WebGPUBufferIdentifier identifier)
    void CreateTexture(WebKit::WebGPU::TextureDescriptor descriptor, WebKit::WebGPUTextureIdentifier identifier)
    void CreateSampler(WebKit::WebGPU::SamplerDescriptor descriptor, WebKit::WebGPUSamplerIdentifier identifier)
    void CreateBindGroupLayout(WebKit::WebGPU::BindGroupLayoutDescriptor descriptor, WebKit::WebGPUBindGroupLayoutIdentifier identifier)
    void CreatePipelineLayout(WebKit::WebGPU::PipelineLayoutDescriptor descriptor, WebKit::WebGPUPipelineLayoutIdentifier identifier)
    void CreateBindGroup(WebKit::WebGPU::BindGroupDescriptor descriptor, WebKit::WebGPUBindGroupIdentifier identifier)
    void CreateShaderModule(WebKit::WebGPU::ShaderModuleDescriptor descriptor, WebKit::WebGPUShaderModuleIdentifier identifier)
    void CreateComputePipeline(WebKit::WebGPU::ComputePipelineDescriptor descriptor, WebKit::WebGPUComputePipelineIdentifier identifier)
    void CreateComputePipelineWithPipelineLayoutFromPipeline(WebKit::WebGPU::ComputePipelineDescriptor descriptor, WebKit::WebGPUComputePipelineIdentifier identifier, WebKit::WebGPUComputePipelineIdentifier pipelineToReplaceIdentifier) -> (bool success)
    void CreateRenderPipeline(WebKit::WebGPU::RenderPipelineDescriptor descriptor, WebKit::WebGPURenderPipelineIdentifier identifier)
    void CreateRenderPipelineWithPipelineLayoutFromPipeline(WebKit::WebGPU::RenderPipelineDescriptor descriptor, WebKit::WebGPURenderPipelineIdentifier identifier, WebKit::WebGPURenderPipelineIdentifier pipelineToReplaceIdentifier) -> (bool success)
    void CreateComputePipelineAsync(WebKit::WebGPU::ComputePipelineDescriptor descriptor, WebKit::WebGPUComputePipelineIdentifier identifier) -> (bool success, String error) ReplyCanDispatchOutOfOrder
    void CreateRenderPipelineAsync(WebKit::WebGPU::RenderPipelineDescriptor descriptor, WebKit::WebGPURenderPipelineIdentifier identifier) -> (bool success, String error) ReplyCanDispatchOutOfOrder
    void CreateCommandEncoder(std::optional<WebKit::WebGPU::CommandEncoderDescriptor> descriptor, WebKit::WebGPUCommandEncoderIdentifier identifier)
    void CreateRenderBundleEncoder(WebKit::WebGPU::RenderBundleEncoderDescriptor descriptor, WebKit::WebGPURenderBundleEncoderIdentifier identifier)
    void CreateQuerySet(WebKit::WebGPU::QuerySetDescriptor descriptor, WebKit::WebGPUQuerySetIdentifier identifier)
    void PushErrorScope(::WebGPU::ErrorFilter errorFilter)
    void PopErrorScope() -> (bool success, std::optional<::WebGPU::Error> error) ReplyCanDispatchOutOfOrder
    void SetListensForUncapturedErrors(bool listens)
    void ResolveDeviceLostPromise() -> (::WebGPU::DeviceLostReason reason, bool isLost)
    void SetLabel(String label)
    void PauseAllErrorReporting(bool pauseErrorReporting)

    void CreateInvalidBindGroup(WebKit::WebGPUBindGroupIdentifier identifier)
    void CreateInvalidBindGroupLayout(WebKit::WebGPUBindGroupLayoutIdentifier identifier)
    void CreateInvalidBuffer(WebKit::WebGPUBufferIdentifier identifier)
    void CreateInvalidCommandBuffer(WebKit::WebGPUCommandBufferIdentifier identifier)
    void CreateInvalidCommandEncoder(WebKit::WebGPUCommandEncoderIdentifier identifier)
    void CreateInvalidComputePipeline(WebKit::WebGPUComputePipelineIdentifier identifier)
    void CreateInvalidPipelineLayout(WebKit::WebGPUPipelineLayoutIdentifier identifier)
    void CreateInvalidQuerySet(WebKit::WebGPUQuerySetIdentifier identifier)
    void CreateInvalidRenderBundleEncoder(String error, WebKit::WebGPURenderBundleEncoderIdentifier identifier)
    void CreateInvalidRenderPipeline(WebKit::WebGPURenderPipelineIdentifier identifier)
    void CreateInvalidSampler(WebKit::WebGPUSamplerIdentifier identifier)
    void CreateInvalidShaderModule(WebKit::WebGPUShaderModuleIdentifier identifier)
    void CreateInvalidTexture(WebKit::WebGPUTextureIdentifier identifier)
    void GenerateAValidationError(String message)
#if PLATFORM(COCOA) && ENABLE(VIDEO)
    void SetSharedVideoFrameSemaphore(IPC::Semaphore semaphore) NotStreamEncodable
    void SetSharedVideoFrameMemory(WebCore::SharedMemory::Handle storageHandle) NotStreamEncodable
    void ImportExternalTextureFromVideoFrame(WebKit::WebGPU::ExternalTextureDescriptor descriptor, WebKit::WebGPUExternalTextureIdentifier identifier) NotStreamEncodable
    void UpdateExternalTexture(WebKit::WebGPUExternalTextureIdentifier externalTextureIdentifier, WebCore::MediaPlayerIdentifier mediaIdentifier)
#endif
}

#endif

#include "BaseTarget.xcconfig"

PRODUCT_NAME = WebKitModelSwift;
INSTALL_PATH = $(WK_LIBRARY_INSTALL_PATH);
SKIP_INSTALL = $(SKIP_INSTALL_$(FORCE_TOOL_INSTALL));
SKIP_INSTALL_ = YES;
SKIP_INSTALL_NO = YES;
SKIP_INSTALL_YES = NO;
GCC_SYMBOLS_PRIVATE_EXTERN = YES;

OTHER_LDFLAGS = $(inherited) $(SOURCE_VERSION_LDFLAGS);

BUILD_LIBRARY_FOR_DISTRIBUTION = NO;
SWIFT_INSTALL_OBJC_HEADER = NO;
SWIFT_LIBRARY_LEVEL = other;

// The WebKit_Internal module is only buildable by the WebKit target, whose header map is the
// only one with entries for its project headers, so take ModelTypes.h as a bridging header.
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/GPUProcess/graphics/Model/ModelTypes.h;
SWIFT_INCLUDE_PATHS = $(SWIFT_INCLUDE_PATHS_$(USE_INTERNAL_SDK));

// This should match the rest of WebKit and use `-Onone`, but it negatively impacts build time.
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -O;

WK_MODEL_SWIFT_FLAGS = -Xfrontend -disable-autolink-framework -Xfrontend RealityKit -Xfrontend -disable-autolink-framework -Xfrontend RealityFoundation -Xfrontend -disable-autolink-framework -Xfrontend USDKit -Xfrontend -disable-autolink-framework -Xfrontend _USDKit_RealityKit -Xfrontend -disable-autolink-framework -Xfrontend DirectResource -Xfrontend -disable-autolink-framework -Xfrontend RealityFusion -Xfrontend -disable-autolink-framework -Xfrontend CoreRealityIO -Xfrontend -disable-autolink-framework -Xfrontend ConfigurationEngineModel -Xfrontend -disable-autolink-framework -Xfrontend RealityCoreDeformation -Xfrontend -disable-autolink-framework -Xfrontend RealityCoreRenderer -Xfrontend -disable-autolink-framework -Xfrontend RealityCoreTextureProcessing -Xfrontend -disable-autolink-framework -Xfrontend RealityFoundationCloth -Xfrontend -disable-autolink-framework -Xfrontend ShaderGraph -Xfrontend -disable-reflection-metadata -Xfrontend -disable-concrete-type-metadata-mangled-name-accessors;

OTHER_SWIFT_FLAGS = $(inherited) $(WK_MODEL_SWIFT_FLAGS);

CLANG_INSTRUMENT_FOR_OPTIMIZATION_PROFILING = NO; // Disable PGO profile generation
WK_CLANG_PGO_GEN_FLAGS = ; // Disable IR PGO profile generation
WK_CLANG_PGO_USE_CFLAGS = ; // Disable IR PGO profile use
WK_CLANG_PGO_USE_LDFLAGS = ; // Disable IR PGO profile use
WK_SWIFT_PGO_GEN_FLAGS = ; // Disable Swift IR PGO profile generation
WK_SWIFT_PGO_USE_FLAGS = ; // Disable Swift IR PGO profile use

WKMS_EXCLUDED_SWIFT_FILE_NAMES = $(WKMS_EXCLUDED_SWIFT_FILE_NAMES_$(USE_INTERNAL_SDK));
WKMS_EXCLUDED_SWIFT_FILE_NAMES_ = GPUProcess/graphics/Model/*.swift;

EXCLUDED_SOURCE_FILE_NAMES = $(WKMS_EXCLUDED_SWIFT_FILE_NAMES);

// This file keeps the target buildable in configurations where all other files are excluded.
INCLUDED_SOURCE_FILE_NAMES = GPUProcess/graphics/Model/Empty.swift;

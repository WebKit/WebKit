#if USE(GSTREAMER_WEBRTC)

[
    ExceptionForEnabledBy,
    DispatchedFrom=WebContent,
    DispatchedTo=Networking
]
messages -> GStreamerIceBackend {
    SetForceRelay(bool forceRelay);
    SetStunServer(String uri);
    AddTurnServer(String uri) -> (Expected<bool, WebCore::ExceptionData> result) Synchronous
    SetTurnServer(String uri);
    AddStream(unsigned sessionId) -> (std::optional<unsigned> streamId) Synchronous
    GatherCandidatesForStream(unsigned streamId) -> (bool result) Synchronous
    SetIsController(bool isController);
    AddCandidate(unsigned streamId, String candidate) -> (Expected<bool, WebCore::ExceptionData> result)
    SetTos(unsigned streamId, unsigned tos);
    SetLocalCredentials(unsigned streamId, String ufrag, String pwd) -> (bool result) Synchronous
    SetRemoteCredentials(unsigned streamId, String ufrag, String pwd) -> (bool result) Synchronous
    SendData(unsigned streamId, enum:uint8_t WebCore::RTCIceComponent component, Vector<WebCore::GStreamerIceBuffer> buffers);
    FinalizeStream(unsigned streamId);
    GetSelectedPairStats(unsigned streamId) -> (struct std::optional<WebCore::GStreamerIceCandidateStatsPair> stats) Synchronous
}

#endif
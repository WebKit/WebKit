#if PLATFORM(IOS_FAMILY) || (PLATFORM(MAC) && ENABLE(VIDEO_PRESENTATION_MODE))
[
    EnabledBy=VideoPresentationManagerEnabled || VideoPresentationModeAPIEnabled,
    SharedPreferencesNeedsConnection,
    DispatchedFrom=WebContent,
    DispatchedTo=UI
]
messages -> PlaybackSessionManagerProxy {
    CurrentTimeChanged(WebCore::MediaPlayerClientIdentifier identifier, double currentTime, double hostTime)
    BufferedTimeChanged(WebCore::MediaPlayerClientIdentifier identifier, double bufferedTime)
    SeekableRangesVectorChanged(WebCore::MediaPlayerClientIdentifier identifier, WebCore::PlatformTimeRanges ranges, double lastModifiedTime, double liveUpdateInterval)
    CanPlayFastReverseChanged(WebCore::MediaPlayerClientIdentifier identifier, bool value)
    AudioMediaSelectionOptionsChanged(WebCore::MediaPlayerClientIdentifier identifier, Vector<WebCore::MediaSelectionOption> options, uint64_t selectedIndex)
    LegibleMediaSelectionOptionsChanged(WebCore::MediaPlayerClientIdentifier identifier, Vector<WebCore::MediaSelectionOption> options, uint64_t selectedIndex)
    AudioMediaSelectionIndexChanged(WebCore::MediaPlayerClientIdentifier identifier, uint64_t selectedIndex)
    LegibleMediaSelectionIndexChanged(WebCore::MediaPlayerClientIdentifier identifier, uint64_t selectedIndex)
    ExternalPlaybackPropertiesChanged(WebCore::MediaPlayerClientIdentifier identifier, bool enabled, enum:uint8_t WebCore::PlaybackSessionModelExternalPlaybackTargetType targetType, String localizedDeviceName)
    WirelessVideoPlaybackDisabledChanged(WebCore::MediaPlayerClientIdentifier identifier, bool disabled)
    DurationChanged(WebCore::MediaPlayerClientIdentifier identifier, double duration)
    PlaybackStartedTimeChanged(WebCore::MediaPlayerClientIdentifier identifier, double playbackStartedTime)
    RateChanged(WebCore::MediaPlayerClientIdentifier identifier, OptionSet<WebCore::PlaybackSessionModelPlaybackState> playbackState, double rate, double defaultPlaybackRate)
    MutedChanged(WebCore::MediaPlayerClientIdentifier identifier, bool muted);
    VolumeChanged(WebCore::MediaPlayerClientIdentifier identifier, double volume);
    PictureInPictureSupportedChanged(WebCore::MediaPlayerClientIdentifier identifier, bool pictureInPictureSupported)
    IsInWindowFullscreenActiveChanged(WebCore::MediaPlayerClientIdentifier identifier, bool isInWindow)
#if HAVE(PIP_SKIP_PREROLL)
    CanSkipAdChanged(WebCore::MediaPlayerClientIdentifier identifier, bool value)
#endif
#if ENABLE(LINEAR_MEDIA_PLAYER)
    SupportsLinearMediaPlayerChanged(WebCore::MediaPlayerClientIdentifier identifier, bool supportsLinearMediaPlayer)
#endif
    ImmersiveVideoMetadataChanged(WebCore::MediaPlayerClientIdentifier identifier, struct std::optional<WebCore::ImmersiveVideoMetadata> metadata);
    SetUpPlaybackControlsManagerWithID(WebCore::MediaPlayerClientIdentifier identifier, bool isVideo)
    ClearPlaybackControlsManager()

    SwapFullscreenModes(WebCore::MediaPlayerClientIdentifier firstIdentifier, WebCore::MediaPlayerClientIdentifier secondIdentifier)

    HandleControlledElementIDResponse(WebCore::MediaPlayerClientIdentifier identifier, String id)

#if !RELEASE_LOG_DISABLED
    SetLogIdentifier(WebCore::MediaPlayerClientIdentifier identifier, uint64_t logIdentifier)
#endif
}
#endif

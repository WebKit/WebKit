#if ENABLE(VIRTUAL_AUDIO_DEVICES)

header: <WebCore/VirtualAudioDevice.h>
enum class WebCore::VirtualAudioSampleFormat : uint8_t {
    S8,
    U8,
    S16LittleEndian,
    S16BigEndian,
    U16LittleEndian,
    U16BigEndian,
    S24LittleEndian,
    S24BigEndian,
    S24In32LittleEndian,
    S24In32BigEndian,
    S32LittleEndian,
    S32BigEndian,
    U32LittleEndian,
    U32BigEndian,
    F32LittleEndian,
    F32BigEndian,
    F64LittleEndian,
    F64BigEndian
}

header: <WebCore/VirtualAudioDevice.h>
enum class WebCore::VirtualAudioLayout : bool

header: <WebCore/VirtualAudioDevice.h>
[CustomHeader] struct WebCore::VirtualAudioDeviceConfiguration {
    String name;
    String label;
    WebCore::VirtualAudioSampleFormat format;
    uint32_t sampleRate;
    uint32_t numberOfChannels;
    uint64_t channelMask;
    WebCore::VirtualAudioLayout layout;
    uint32_t framesPerBuffer;
    bool isDefault;
}

headers: "VirtualAudioDeviceParameters.h" <wtf/unix/UnixFileDescriptor.h> "ArgumentCodersUnix.h"
[RValue] struct WebKit::VirtualAudioDeviceParameters {
    WebCore::VirtualAudioDeviceConfiguration configuration;
    String persistentId;
    UnixFileDescriptor socket;
}

#endif

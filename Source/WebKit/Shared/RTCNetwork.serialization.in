#if USE(LIBWEBRTC)

header: "RTCNetwork.h"
enum class WebKit::WebRTCNetwork::EcnMarking : int {
    kNotEct,
    kEct1,
    kEct0,
    kCe
}

[CustomHeader] struct WebKit::WebRTCNetwork::IPAddress {
    Variant<WebKit::WebRTCNetwork::IPAddress::UnspecifiedFamily, uint32_t, std::array<uint32_t, 4>> value;
};

[Nested] struct WebKit::WebRTCNetwork::IPAddress::UnspecifiedFamily {
};

[CustomHeader] struct WebKit::WebRTCNetwork::InterfaceAddress {
    WebKit::WebRTCNetwork::IPAddress address;
    int ipv6Flags;
};

[CustomHeader] struct WebKit::WebRTCNetwork::SocketAddress {
    uint16_t port;
    int scopeID;
    String hostname;
    std::optional<WebKit::WebRTCNetwork::IPAddress> ipAddress;
};

struct WebKit::RTCNetwork {
    String name;
    String description;
    WebKit::WebRTCNetwork::IPAddress prefix;
    int prefixLength;
    int type;
    uint16_t id;
    int preference;
    bool active;
    bool ignored;
    int scopeID;
    Vector<WebKit::WebRTCNetwork::InterfaceAddress> ips;
};

struct WebKit::RTCSocketCreationFlags {
    bool isFirstParty;
    bool isRelayDisabled;
    bool enableServiceClass;
};

#if USE(LIBWEBRTC) && PLATFORM(COCOA)
header: <WebCore/GPUVideoEncoder.h>
[CustomHeader] struct WebCore::GPUVideoEncoderFrameInfo {
    uint32_t width;
    uint32_t height;
    int64_t timeStamp;
    std::optional<uint64_t> duration;
    int64_t captureTimeMS;
    bool isKeyFrame;
    WebCore::VideoFrameRotation rotation;
    bool isScreenshare;
    int qp;
    std::optional<uint8_t> temporalIndex;
};
#endif

#endif

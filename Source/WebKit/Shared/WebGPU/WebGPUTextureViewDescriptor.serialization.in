#if ENABLE(GPU_PROCESS)
header: <WebGPU/WebGPUCpp.h>
[AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct ::WebGPU::TextureViewDescriptor {
    String label;
    std::optional<::WebGPU::TextureFormat> format;
    std::optional<::WebGPU::TextureViewDimension> dimension;
    uint32_t baseMipLevel;
    std::optional<uint32_t> mipLevelCount;
    uint32_t baseArrayLayer;
    std::optional<uint32_t> arrayLayerCount;
    ::WebGPU::TextureAspect aspect;
    OptionSet<::WebGPU::TextureUsage> usage;
};

header: "WebGPUTextureViewDescriptor.h"
using WebKit::WebGPU::TextureViewDescriptor = ::WebGPU::TextureViewDescriptor;
#endif

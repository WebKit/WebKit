header: <WebCore/SourceBrushLogicalGradient.h>
[CustomHeader] struct WebCore::SourceBrushLogicalGradient {
    Ref<WebCore::Gradient> gradient;
    WebCore::AffineTransform spaceTransform;
}

header: <WebCore/GraphicsContextState.h>
[Nested, OptionSet] enum class WebCore::GraphicsContextState::Change : uint32_t {
    FillBrush,
    FillRule,
    StrokeBrush,
    StrokeThickness,
    StrokeStyle,
    CompositeMode,
    DropShadow,
    Style,
    Alpha,
    TextDrawingMode,
    ImageInterpolationQuality,
    ShouldAntialias,
    ShouldSmoothFonts,
    ShouldSubpixelQuantizeFonts,
    ShadowsIgnoreTransforms,
}

header: <WebCore/SourceBrush.h>
[CustomHeader] class WebCore::SourceBrush {
    WebCore::Color color();
    std::optional<WebCore::SourceBrushLogicalGradient> logicalGradient();
}

[CustomHeader] class WebCore::GraphicsContextState {
    OptionSet<WebCore::GraphicsContextState::Change> changes();
    WebCore::SourceBrush fillBrush();
    WebCore::WindRule fillRule();
    WebCore::SourceBrush strokeBrush();
    float strokeThickness();
    WebCore::StrokeStyle strokeStyle();
    WebCore::CompositeMode compositeMode();
    std::optional<WebCore::GraphicsDropShadow> dropShadow();
    std::optional<WebCore::GraphicsStyle> style();
    float alpha();
    WebCore::InterpolationQuality imageInterpolationQuality();
    OptionSet<WebCore::TextDrawingMode> textDrawingMode();
    bool shouldAntialias();
    bool shouldSmoothFonts();
    bool shouldSubpixelQuantizeFonts();
    bool shadowsIgnoreTransforms();
}


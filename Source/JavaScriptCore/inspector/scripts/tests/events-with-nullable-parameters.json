[
    {
        "domain": "BidiBrowser",
        "types": [
            {
                "id": "ClientWindow",
                "type": "string"
            },
            {
                "id": "UserContext",
                "type": "string"
            }
        ]
    },
    {
        "domain": "BidiBrowsingContext",
        "types": [
            {
                "id": "BrowsingContext",
                "type": "string"
            },
            {
                "id": "Info",
                "type": "object",
                "properties": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "url", "type": "string" },
                    { "name": "originalOpener", "$ref": "BidiBrowsingContext.BrowsingContext", "nullable": true },
                    { "name": "parent", "$ref": "BidiBrowsingContext.BrowsingContext", "optional": true, "nullable": true },
                    { "name": "children", "type": "array", "items": { "$ref": "BidiBrowsingContext.Info" }, "nullable": true },
                    { "name": "clientWindow", "$ref": "BidiBrowser.ClientWindow" },
                    { "name": "userContext", "$ref": "BidiBrowser.UserContext" }
                ]
            },
            {
                "id": "NavigationID",
                "type": "string"
            }
        ],
        "events": [
            {
                "name": "navigationStarted",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "navigation", "$ref": "BidiBrowsingContext.NavigationID", "nullable": true },
                    { "name": "timestamp", "type": "number" },
                    { "name": "url", "type": "string" }
                ]
            },
            {
                "name": "navigationFailed",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "navigation", "$ref": "BidiBrowsingContext.NavigationID", "nullable": true },
                    { "name": "timestamp", "type": "number" },
                    { "name": "url", "type": "string" }
                ]
            },
            {
                "name": "fragmentNavigated",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "navigation", "$ref": "BidiBrowsingContext.NavigationID", "nullable": true },
                    { "name": "timestamp", "type": "number" },
                    { "name": "url", "type": "string" }
                ]
            },
            {
                "name": "domContentLoaded",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "navigation", "$ref": "BidiBrowsingContext.NavigationID", "nullable": true },
                    { "name": "timestamp", "type": "number" },
                    { "name": "url", "type": "string" }
                ]
            },
            {
                "name": "load",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "navigation", "$ref": "BidiBrowsingContext.NavigationID", "nullable": true },
                    { "name": "timestamp", "type": "number" },
                    { "name": "url", "type": "string" }
                ]
            },
            {
                "name": "contextCreated",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "url", "type": "string" },
                    { "name": "originalOpener", "$ref": "BidiBrowsingContext.BrowsingContext", "nullable": true },
                    { "name": "parent", "$ref": "BidiBrowsingContext.BrowsingContext", "optional": true, "nullable": true },
                    { "name": "children", "type": "array", "items": { "$ref": "BidiBrowsingContext.Info" }, "nullable": true },
                    { "name": "clientWindow", "$ref": "BidiBrowser.ClientWindow" },
                    { "name": "userContext", "$ref": "BidiBrowser.UserContext" }
                ]
            },
            {
                "name": "contextDestroyed",
                "parameters": [
                    { "name": "context", "$ref": "BidiBrowsingContext.BrowsingContext" },
                    { "name": "url", "type": "string" },
                    { "name": "originalOpener", "$ref": "BidiBrowsingContext.BrowsingContext", "nullable": true },
                    { "name": "parent", "$ref": "BidiBrowsingContext.BrowsingContext", "optional": true, "nullable": true },
                    { "name": "children", "type": "array", "items": { "$ref": "BidiBrowsingContext.Info" }, "nullable": true },
                    { "name": "clientWindow", "$ref": "BidiBrowser.ClientWindow" },
                    { "name": "userContext", "$ref": "BidiBrowser.UserContext" }
                ]
            }
        ]
    },
    {
        "domain": "Database",
        "types": [
            {
                "id": "PrimaryColors",
                "type": "string",
                "values": ["red", "green", "blue"]
            },
            {
                "id": "ColorList",
                "type": "array",
                "items": { "$ref": "PrimaryColors" }
            },
            {
                "id": "Error",
                "type": "object",
                "properties": [
                    { "name": "message", "type": "string" },
                    { "name": "code", "type": "integer" }
                ]
            }
        ],
        "events": [
            {
                "name": "didExecuteNullableParameters",
                "parameters": [
                    { "name": "columnNames", "type": "array", "nullable": true, "items": { "type": "string" } },
                    { "name": "notes", "type": "string", "nullable": true },
                    { "name": "timestamp", "type": "number", "nullable": true },
                    { "name": "values", "type": "object", "nullable": true },
                    { "name": "payload", "type": "any", "nullable": true },
                    { "name": "sqlError", "$ref": "Error", "nullable": true },
                    { "name": "screenColor", "$ref": "PrimaryColors", "nullable": true },
                    { "name": "alternateColors", "$ref": "ColorList", "nullable": true },
                    { "name": "printColor", "type": "string", "values": ["cyan", "magenta", "yellow", "black"], "nullable": true }
                ]
            },
            {
                "name": "didExecuteOptionalNullableParameters",
                "parameters": [
                    { "name": "columnNames", "type": "array", "optional": true, "nullable": true, "items": { "type": "string" } },
                    { "name": "notes", "type": "string", "optional": true, "nullable": true },
                    { "name": "timestamp", "type": "number", "optional": true, "nullable": true },
                    { "name": "values", "type": "object", "optional": true, "nullable": true },
                    { "name": "payload", "type": "any", "optional": true, "nullable": true },
                    { "name": "sqlError", "$ref": "Error", "optional": true, "nullable": true },
                    { "name": "screenColor", "$ref": "PrimaryColors", "optional": true, "nullable": true },
                    { "name": "alternateColors", "$ref": "ColorList", "optional": true, "nullable": true },
                    { "name": "printColor", "type": "string", "values": ["cyan", "magenta", "yellow", "black"], "optional": true, "nullable": true }
                ]
            }
        ]
    }
]
